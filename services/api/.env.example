WF_PLATFORM_API_BASE=https://platform.example.com/api
WF_REQUEST_TIMEOUT=15
WF_DEFAULT_HEADERS={"X-Requested-By":"nexus-workflow"}
WF_DATABASE_URL=mysql+pymysql://workflow:workflow@mysql:3306/workflow
WF_MINIO_ENDPOINT=http://minio:9000
WF_MINIO_BUCKET=runs
WF_MINIO_ACCESS_KEY=workflow
WF_MINIO_SECRET_KEY=workflow_secret
WF_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
WF_N8N_APPROVAL_WEBHOOK=http://n8n:5678/webhook/approval
WF_N8N_LINK_SUBMISSION_WEBHOOK=http://n8n:5678/webhook/link-submission
WF_CORS_ALLOW_ORIGINS=*

# Workflow tag filtering
# Banned tags are stored in the database table `banned_tags` and managed via:
# - GET /banned-tags
# - POST /banned-tags
# - DELETE /banned-tags/{tag}
#
# Allowed search tags are stored in `allowed_search_tags` and managed via:
# - GET /allowed-search-tags
# - POST /allowed-search-tags
# - DELETE /allowed-search-tags/{type}/{tag}
#
# The following env vars are kept for backward compatibility but are no longer used:
# WF_BANNED_TAGS=["English text","watermark","logo"]
# WF_BANNED_TAGS_FILE=/run/secrets/banned_tags.txt

# WD1.4 autotagging (SmilingWolf/wd-v1-4-convnext-tagger)
WF_WD14_CACHE_DIR=/tmp/wd14_cache
WF_WD14_GENERAL_THRESHOLD=0.35
WF_WD14_CHARACTER_THRESHOLD=0.85
